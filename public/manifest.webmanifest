{
  "name": "KKfy — your local music",
  "short_name": "KKfy",
  "description": "A small, fast music player for your own library.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
